# ===================================================================
# ClearDoc Configuration
# ===================================================================

# AI Provider to use:
# 'api'   -> Google AI Studio Gemini API (uses Gemma 4 on the cloud)
# 'local' -> Ollama running on your computer
PROVIDER=api

# Google AI Studio API Key (required when PROVIDER=api)
# In AI Studio, this is automatically provided from your secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Gemma 4 Cloud Model ID on Google AI Studio
# Default: gemma-4-26b-a4b-it
# Other options: gemma-4-31b-it
GEMMA_MODEL="gemma-4-26b-a4b-it"

# Local Ollama Settings (used when PROVIDER=local)
# Make sure Ollama is running and has gemma4:e2b installed (ollama run gemma4:e2b)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="gemma4:e2b"

# Web server port
PORT=3000
